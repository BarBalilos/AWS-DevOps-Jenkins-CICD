pipeline {
    agent { label 'cd-agent' }
    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Image tag produced by CI (e.g. <git-sha>-<build-number>).')
        string(name: 'IMAGE_DIGEST', defaultValue: '', description: 'backend=sha256:...,worker=sha256:... — digests produced by CI.')
        string(name: 'NAMESPACE', defaultValue: 'devops-app', description: 'Target Kubernetes namespace.')
        string(name: 'TRIGGERED_BY_BUILD', defaultValue: '', description: 'Identifier of the upstream CI build that triggered this deploy.')
        string(name: 'APP_COMMIT_SHA', defaultValue: '', description: 'Exact commit SHA of AWS-DevOps-Kubernetes (manifests repo) to deploy, produced by CI.')
    }
    environment {
        ECR_REGISTRY = "938834037970.dkr.ecr.us-east-1.amazonaws.com"
        AWS_REGION = "us-east-1"
        APP_REPO_URL = "https://github.com/BarBalilos/AWS-DevOps-Kubernetes.git"
        APP_REPO_BRANCH = "main"
        PROMETHEUS_URL = "http://kube-prometheus-stack-prometheus.observability.svc.cluster.local:9090"
    }
    stages {
        stage('Checkout') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        apk add --no-cache git
                        if [ -z "${APP_COMMIT_SHA}" ]; then
                            echo "ERROR: APP_COMMIT_SHA is empty — CD must be triggered with an exact commit SHA from CI." >&2
                            exit 1
                        fi
                        if ! echo "${APP_COMMIT_SHA}" | grep -Eq '^[0-9a-f]{40}$'; then
                            echo "ERROR: APP_COMMIT_SHA '${APP_COMMIT_SHA}' is not a valid 40-character git SHA." >&2
                            exit 1
                        fi
                    '''
                    dir('app-src') {
                        git branch: "${APP_REPO_BRANCH}", url: "${APP_REPO_URL}"
                        sh 'git checkout "${APP_COMMIT_SHA}"'
                    }
                    sh 'git config --global --add safe.directory "*"'
                    echo "Checked out app-src @ exact commit ${params.APP_COMMIT_SHA} (manifests only — no build happens here)."
                }
            }
        }
        stage('Input Validation') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        if [ -z "${IMAGE_TAG}" ]; then
                            echo "ERROR: IMAGE_TAG is empty." >&2
                            exit 1
                        fi
                        if [ "${IMAGE_TAG}" = "latest" ]; then
                            echo "ERROR: IMAGE_TAG must not be 'latest'." >&2
                            exit 1
                        fi
                        BACKEND_DIGEST=$(echo "${IMAGE_DIGEST}" | tr ',' '\n' | grep '^backend=' | cut -d'=' -f2-)
                        WORKER_DIGEST=$(echo "${IMAGE_DIGEST}" | tr ',' '\n' | grep '^worker=' | cut -d'=' -f2-)
                        if [ -z "${BACKEND_DIGEST}" ] || [ -z "${WORKER_DIGEST}" ]; then
                            echo "ERROR: could not parse backend/worker digests from IMAGE_DIGEST." >&2
                            exit 1
                        fi
                        case "${BACKEND_DIGEST}" in
                            sha256:*) ;;
                            *) echo "ERROR: BACKEND_DIGEST must start with sha256:" >&2; exit 1 ;;
                        esac
                        case "${WORKER_DIGEST}" in
                            sha256:*) ;;
                            *) echo "ERROR: WORKER_DIGEST must start with sha256:" >&2; exit 1 ;;
                        esac
                        if [ "${NAMESPACE}" != "devops-app" ]; then
                            echo "ERROR: NAMESPACE must be devops-app." >&2
                            exit 1
                        fi
                        kubectl get namespace "${NAMESPACE}" > /dev/null
                        echo "${BACKEND_DIGEST}" > backend-digest.txt
                        echo "${WORKER_DIGEST}" > worker-digest.txt
                        echo "Input validation OK."
                        echo "  IMAGE_TAG:           ${IMAGE_TAG}"
                        echo "  BACKEND_DIGEST:      ${BACKEND_DIGEST}"
                        echo "  WORKER_DIGEST:       ${WORKER_DIGEST}"
                        echo "  NAMESPACE:           ${NAMESPACE}"
                        echo "  TRIGGERED_BY_BUILD:  ${TRIGGERED_BY_BUILD}"
                        echo "  APP_COMMIT_SHA:      ${APP_COMMIT_SHA}"
                    '''
                    script {
                        env.BACKEND_DIGEST = sh(script: 'cat backend-digest.txt', returnStdout: true).trim()
                        env.WORKER_DIGEST = sh(script: 'cat worker-digest.txt', returnStdout: true).trim()
                    }
                }
            }
        }
        stage('Manifest Discovery & Validation') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        find app-src/k8s -maxdepth 1 -type f -name '*.yaml' ! -name '*namespace*' ! -name '*secret*' | sort > manifest-files.txt
                        echo "Manifests to apply (namespace/secret files excluded by design):"
                        cat manifest-files.txt

                        BACKEND_DIGEST=$(cat backend-digest.txt)
                        WORKER_DIGEST=$(cat worker-digest.txt)
                        echo "-- Rendering real image digests into manifests before validation --"
                        sed -i "s#image: devops-backend:v1#image: ${ECR_REGISTRY}/devops-app-backend@${BACKEND_DIGEST}#" app-src/k8s/05-backend-deployment.yaml
                        sed -i "s#image: devops-worker:v1#image: ${ECR_REGISTRY}/devops-app-worker@${WORKER_DIGEST}#" app-src/k8s/07-worker-deployment.yaml
                        grep -H 'image:' app-src/k8s/05-backend-deployment.yaml app-src/k8s/07-worker-deployment.yaml

                        echo "-- Dry-run (client) validation --"
                        while IFS= read -r f; do
                            echo "-- dry-run client: ${f} --"
                            kubectl apply --dry-run=client -f "${f}"
                        done < manifest-files.txt
                        echo "-- Dry-run (server) validation --"
                        while IFS= read -r f; do
                            echo "-- dry-run server: ${f} --"
                            kubectl apply --dry-run=server -f "${f}"
                        done < manifest-files.txt
                    '''
                }
            }
        }
        stage('Authenticate / RBAC Sanity Check') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        echo "Running as ServiceAccount: system:serviceaccount:jenkins:jenkins-cd-agent (in-cluster auth)"
                        kubectl auth can-i patch deployments -n "${NAMESPACE}"
                        kubectl auth can-i create pods --subresource=exec -n "${NAMESPACE}"
                        echo "RBAC sanity checks passed."
                    '''
                }
            }
        }
        stage('Refresh ECR Pull Secret') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        aws --version > /dev/null 2>&1 || apk add --no-cache aws-cli
                        set +x
                        ECR_PASSWORD=$(aws ecr get-login-password --region "${AWS_REGION}")
                        kubectl create secret docker-registry ecr-pull-secret \
                          --docker-server="${ECR_REGISTRY}" \
                          --docker-username=AWS \
                          --docker-password="${ECR_PASSWORD}" \
                          -n "${NAMESPACE}" \
                          --dry-run=client -o yaml | kubectl apply -f -
                        set -x
                        echo "ECR pull secret refreshed. (backend-sa/worker-sa linkage happens in the Deploy stage, after those ServiceAccounts are guaranteed to exist.)"
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        while IFS= read -r f; do
                            echo "-- apply: ${f} --"
                            kubectl apply -f "${f}"
                        done < manifest-files.txt

                        echo "Linking ecr-pull-secret to backend-sa/worker-sa (ServiceAccounts now guaranteed to exist)..."
                        kubectl patch serviceaccount backend-sa -n "${NAMESPACE}" --type=merge -p '{"imagePullSecrets":[{"name":"ecr-pull-secret"}]}'
                        kubectl patch serviceaccount worker-sa -n "${NAMESPACE}" --type=merge -p '{"imagePullSecrets":[{"name":"ecr-pull-secret"}]}'

                        BACKEND_DIGEST=$(cat backend-digest.txt)
                        WORKER_DIGEST=$(cat worker-digest.txt)
                        echo "backend/worker manifests already pin digests ${BACKEND_DIGEST} / ${WORKER_DIGEST} (rendered during Manifest Discovery & Validation) — no separate 'kubectl set image' needed."
                        GIT_SHA_SHORT=$(echo "${IMAGE_TAG}" | cut -c1-12)
                        RELEASE_ID="application-cd-${BUILD_NUMBER}"
                        echo "Setting app_info env vars: APP_VERSION=${IMAGE_TAG} GIT_SHA=${GIT_SHA_SHORT} RELEASE=${RELEASE_ID}"
                        kubectl set env deployment/backend -n "${NAMESPACE}" APP_VERSION="${IMAGE_TAG}" GIT_SHA="${GIT_SHA_SHORT}" RELEASE="${RELEASE_ID}"
                        kubectl set env deployment/worker -n "${NAMESPACE}" APP_VERSION="${IMAGE_TAG}" GIT_SHA="${GIT_SHA_SHORT}" RELEASE="${RELEASE_ID}"
                        kubectl annotate deployment/backend -n "${NAMESPACE}" deployed-image-tag="${IMAGE_TAG}" deployed-by-build="${TRIGGERED_BY_BUILD}" deployed-manifest-revision="${APP_COMMIT_SHA}" --overwrite
                        kubectl annotate deployment/worker -n "${NAMESPACE}" deployed-image-tag="${IMAGE_TAG}" deployed-by-build="${TRIGGERED_BY_BUILD}" deployed-manifest-revision="${APP_COMMIT_SHA}" --overwrite
                        kubectl rollout restart deployment/backend -n "${NAMESPACE}"
                        kubectl rollout restart deployment/worker -n "${NAMESPACE}"
                    '''
                }
            }
        }
        stage('Rollout') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        kubectl rollout status deployment/backend -n "${NAMESPACE}" --timeout=180s
                        kubectl rollout status deployment/worker -n "${NAMESPACE}" --timeout=180s
                    '''
                }
            }
        }
        stage('Verify') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        kubectl get deployments,pods,services,ingress -n "${NAMESPACE}" -o wide
                        BACKEND_DIGEST=$(cat backend-digest.txt)
                        WORKER_DIGEST=$(cat worker-digest.txt)
                        RUNNING_BACKEND=$(kubectl get deployment backend -n "${NAMESPACE}" -o jsonpath='{.spec.template.spec.containers[0].image}')
                        RUNNING_WORKER=$(kubectl get deployment worker -n "${NAMESPACE}" -o jsonpath='{.spec.template.spec.containers[0].image}')
                        echo "backend running image: ${RUNNING_BACKEND}"
                        echo "worker running image:  ${RUNNING_WORKER}"
                        if ! echo "${RUNNING_BACKEND}" | grep -q "${BACKEND_DIGEST}"; then
                            echo "ERROR: running backend image does not match expected digest ${BACKEND_DIGEST}" >&2
                            exit 1
                        fi
                        if ! echo "${RUNNING_WORKER}" | grep -q "${WORKER_DIGEST}"; then
                            echo "ERROR: running worker image does not match expected digest ${WORKER_DIGEST}" >&2
                            exit 1
                        fi
                        echo "Verified: running images match the requested digests."
                    '''
                }
            }
        }
        stage('Smoke Test') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        BACKEND_POD=$(kubectl get pods -n "${NAMESPACE}" -l app=backend -o jsonpath='{.items[0].metadata.name}')
                        WORKER_POD=$(kubectl get pods -n "${NAMESPACE}" -l app=worker -o jsonpath='{.items[0].metadata.name}')
                        echo "Smoke-testing backend pod ${BACKEND_POD} at /api/health ..."
                        kubectl exec -n "${NAMESPACE}" "${BACKEND_POD}" -- python3 -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/api/health', timeout=5).status)"
                        echo "Smoke-testing worker pod ${WORKER_POD} at /health ..."
                        kubectl exec -n "${NAMESPACE}" "${WORKER_POD}" -- python3 -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5001/health', timeout=5).status)"
                    '''
                }
            }
        }
        stage('Monitoring Gate') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        curl --version > /dev/null 2>&1 || apk add --no-cache curl
                        jq --version > /dev/null 2>&1 || apk add --no-cache jq

                        echo "Waiting 45s for Prometheus to complete a fresh scrape cycle post-rollout..."
                        sleep 45

                        echo "-- Checking scrape targets are up --"
                        UP_RESULT=$(curl -s -G --data-urlencode 'query=up{job=~"devops-app/backend|devops-app/worker"}' "${PROMETHEUS_URL}/api/v1/query")
                        echo "${UP_RESULT}" | jq .

                        UP_COUNT=$(echo "${UP_RESULT}" | jq '[.data.result[] | select(.value[1] == "1")] | length')
                        TOTAL_COUNT=$(echo "${UP_RESULT}" | jq '.data.result | length')

                        if [ "${TOTAL_COUNT}" -lt 2 ] || [ "${UP_COUNT}" -lt 2 ]; then
                            echo "ERROR: expected 2 scrape targets up (devops-app/backend, devops-app/worker), found ${UP_COUNT} up out of ${TOTAL_COUNT} reporting." >&2
                            exit 1
                        fi
                        echo "OK: both backend and worker scrape targets are up."

                        echo "-- Checking error rate / latency SLI over the last 2 minutes --"
                        TOTAL_REQ=$(curl -s -G --data-urlencode 'query=sum(increase(http_requests_total{job=~"devops-app/backend|devops-app/worker"}[2m]))' "${PROMETHEUS_URL}/api/v1/query" | jq -r '.data.result[0].value[1] // "0"')
                        TOTAL_REQ_INT=$(echo "${TOTAL_REQ}" | cut -d'.' -f1)
                        if [ -z "${TOTAL_REQ_INT}" ]; then TOTAL_REQ_INT=0; fi

                        if [ "${TOTAL_REQ_INT}" -lt 1 ]; then
                            echo "No request traffic observed in the last 2 minutes yet - skipping error rate/latency gate (nothing to evaluate)."
                        else
                            AVAIL_RATIO=$(curl -s -G --data-urlencode 'query=sum(rate(http_requests_total{job=~"devops-app/backend|devops-app/worker",status!~"5.."}[2m])) / sum(rate(http_requests_total{job=~"devops-app/backend|devops-app/worker"}[2m]))' "${PROMETHEUS_URL}/api/v1/query" | jq -r '.data.result[0].value[1] // "1"')
                            LATENCY_RATIO=$(curl -s -G --data-urlencode 'query=sum(rate(http_request_duration_seconds_bucket{job=~"devops-app/backend|devops-app/worker",le="0.5"}[2m])) / sum(rate(http_request_duration_seconds_count{job=~"devops-app/backend|devops-app/worker"}[2m]))' "${PROMETHEUS_URL}/api/v1/query" | jq -r '.data.result[0].value[1] // "1"')

                            echo "Availability ratio (last 2m): ${AVAIL_RATIO}"
                            echo "Latency (<=500ms) ratio (last 2m): ${LATENCY_RATIO}"

                            AVAIL_OK=$(awk -v v="${AVAIL_RATIO}" 'BEGIN { print (v+0 >= 0.99) ? 1 : 0 }')
                            LATENCY_OK=$(awk -v v="${LATENCY_RATIO}" 'BEGIN { print (v+0 >= 0.95) ? 1 : 0 }')

                            if [ "${AVAIL_OK}" != "1" ]; then
                                echo "ERROR: post-deploy availability ratio ${AVAIL_RATIO} is below the 0.99 SLO threshold." >&2
                                exit 1
                            fi
                            if [ "${LATENCY_OK}" != "1" ]; then
                                echo "ERROR: post-deploy latency (<=500ms) ratio ${LATENCY_RATIO} is below the 0.95 SLO threshold." >&2
                                exit 1
                            fi
                            echo "OK: post-deploy error rate and latency are within SLO thresholds."
                        fi

                        echo "Monitoring gate passed."
                    '''
                }
            }
        }
    }
    post {
        always {
            container('kubectl') {
                sh 'rm -f backend-digest.txt worker-digest.txt manifest-files.txt || true'
            }
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
        success {
            echo "CD succeeded: backend@${env.BACKEND_DIGEST} and worker@${env.WORKER_DIGEST} deployed to ${params.NAMESPACE} @ manifest revision ${params.APP_COMMIT_SHA}, triggered by ${params.TRIGGERED_BY_BUILD}."
        }
        failure {
            container('kubectl') {
                sh '''
                    kubectl get events -n "${NAMESPACE}" --sort-by=.lastTimestamp | tail -50 || true
                '''
            }
            echo """
CD FAILED. Manual rollback:
  kubectl rollout undo deployment/backend -n devops-app
  kubectl rollout undo deployment/worker -n devops-app
"""
        }
    }
}