pipeline {
    agent { label 'cd-agent' }
    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Image tag produced by CI (e.g. <git-sha>-<build-number>).')
        string(name: 'IMAGE_DIGEST', defaultValue: '', description: 'backend=sha256:...,worker=sha256:... — digests produced by CI.')
        string(name: 'NAMESPACE', defaultValue: 'devops-app', description: 'Target Kubernetes namespace.')
        string(name: 'TRIGGERED_BY_BUILD', defaultValue: '', description: 'Identifier of the upstream CI build that triggered this deploy.')
    }
    environment {
        ECR_REGISTRY = "938834037970.dkr.ecr.us-east-1.amazonaws.com"
        AWS_REGION = "us-east-1"
        APP_REPO_URL = "https://github.com/BarBalilos/AWS-DevOps-Kubernetes.git"
        APP_REPO_BRANCH = "main"
    }
    stages {
        stage('Checkout') {
            steps {
                container('kubectl') {
                    sh 'apk add --no-cache git'
                    dir('app-src') {
                        git branch: "${APP_REPO_BRANCH}", url: "${APP_REPO_URL}"
                    }
                    sh 'git config --global --add safe.directory "*"'
                    echo "Checked out app-src @ branch ${APP_REPO_BRANCH} (manifests only — no build happens here)."
                }
            }
        }

        stage('Input Validation') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        if [ -z "${IMAGE_TAG}" ]; then
                            echo "ERROR: IMAGE_TAG is empty." >&2
                            exit 1
                        fi
                        if [ "${IMAGE_TAG}" = "latest" ]; then
                            echo "ERROR: IMAGE_TAG must not be 'latest'." >&2
                            exit 1
                        fi

                        BACKEND_DIGEST=$(echo "${IMAGE_DIGEST}" | tr ',' '\n' | grep '^backend=' | cut -d'=' -f2-)
                        WORKER_DIGEST=$(echo "${IMAGE_DIGEST}" | tr ',' '\n' | grep '^worker=' | cut -d'=' -f2-)

                        if [ -z "${BACKEND_DIGEST}" ] || [ -z "${WORKER_DIGEST}" ]; then
                            echo "ERROR: could not parse backend/worker digests from IMAGE_DIGEST." >&2
                            exit 1
                        fi

                        case "${BACKEND_DIGEST}" in
                            sha256:*) ;;
                            *) echo "ERROR: BACKEND_DIGEST must start with sha256:" >&2; exit 1 ;;
                        esac
                        case "${WORKER_DIGEST}" in
                            sha256:*) ;;
                            *) echo "ERROR: WORKER_DIGEST must start with sha256:" >&2; exit 1 ;;
                        esac

                        if [ "${NAMESPACE}" != "devops-app" ]; then
                            echo "ERROR: NAMESPACE must be devops-app." >&2
                            exit 1
                        fi

                        kubectl get namespace "${NAMESPACE}" > /dev/null

                        echo "${BACKEND_DIGEST}" > backend-digest.txt
                        echo "${WORKER_DIGEST}" > worker-digest.txt

                        echo "Input validation OK."
                        echo "  IMAGE_TAG:           ${IMAGE_TAG}"
                        echo "  BACKEND_DIGEST:      ${BACKEND_DIGEST}"
                        echo "  WORKER_DIGEST:       ${WORKER_DIGEST}"
                        echo "  NAMESPACE:           ${NAMESPACE}"
                        echo "  TRIGGERED_BY_BUILD:  ${TRIGGERED_BY_BUILD}"
                    '''
                    script {
                        env.BACKEND_DIGEST = sh(script: 'cat backend-digest.txt', returnStdout: true).trim()
                        env.WORKER_DIGEST = sh(script: 'cat worker-digest.txt', returnStdout: true).trim()
                    }
                }
            }
        }

        stage('Manifest Discovery & Validation') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        find app-src/k8s -maxdepth 1 -type f -name '*.yaml' ! -name '*namespace*' ! -name '*secret*' | sort > manifest-files.txt
                        echo "Manifests to apply (namespace/secret files excluded by design):"
                        cat manifest-files.txt

                        echo "-- Dry-run (client) validation --"
                        while IFS= read -r f; do
                            echo "-- dry-run client: ${f} --"
                            kubectl apply --dry-run=client -f "${f}"
                        done < manifest-files.txt

                        echo "-- Dry-run (server) validation --"
                        while IFS= read -r f; do
                            echo "-- dry-run server: ${f} --"
                            kubectl apply --dry-run=server -f "${f}"
                        done < manifest-files.txt
                    '''
                }
            }
        }

        stage('Authenticate / RBAC Sanity Check') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        echo "Running as ServiceAccount: system:serviceaccount:jenkins:jenkins-cd-agent (in-cluster auth)"
                        kubectl auth can-i patch deployments -n "${NAMESPACE}"
                        kubectl auth can-i create pods --subresource=exec -n "${NAMESPACE}"
                        echo "RBAC sanity checks passed."
                    '''
                }
            }
        }

        stage('Refresh ECR Pull Secret') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        aws --version > /dev/null 2>&1 || apk add --no-cache aws-cli
                        set +x
                        ECR_PASSWORD=$(aws ecr get-login-password --region "${AWS_REGION}")
                        kubectl create secret docker-registry ecr-pull-secret \
                          --docker-server="${ECR_REGISTRY}" \
                          --docker-username=AWS \
                          --docker-password="${ECR_PASSWORD}" \
                          -n "${NAMESPACE}" \
                          --dry-run=client -o yaml | kubectl apply -f -
                        set -x
                        kubectl patch serviceaccount backend-sa -n "${NAMESPACE}" --type=merge -p '{"imagePullSecrets":[{"name":"ecr-pull-secret"}]}'
                        kubectl patch serviceaccount worker-sa -n "${NAMESPACE}" --type=merge -p '{"imagePullSecrets":[{"name":"ecr-pull-secret"}]}'
                        echo "ECR pull secret refreshed and linked to backend-sa/worker-sa."
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        while IFS= read -r f; do
                            echo "-- apply: ${f} --"
                            kubectl apply -f "${f}"
                        done < manifest-files.txt

                        BACKEND_DIGEST=$(cat backend-digest.txt)
                        WORKER_DIGEST=$(cat worker-digest.txt)

                        echo "Pinning backend to digest ${BACKEND_DIGEST}..."
                        kubectl set image deployment/backend backend="${ECR_REGISTRY}/devops-app-backend@${BACKEND_DIGEST}" -n "${NAMESPACE}"

                        echo "Pinning worker to digest ${WORKER_DIGEST}..."
                        kubectl set image deployment/worker worker="${ECR_REGISTRY}/devops-app-worker@${WORKER_DIGEST}" -n "${NAMESPACE}"

                        kubectl annotate deployment/backend -n "${NAMESPACE}" deployed-image-tag="${IMAGE_TAG}" deployed-by-build="${TRIGGERED_BY_BUILD}" --overwrite
                        kubectl annotate deployment/worker -n "${NAMESPACE}" deployed-image-tag="${IMAGE_TAG}" deployed-by-build="${TRIGGERED_BY_BUILD}" --overwrite

                        kubectl rollout restart deployment/backend -n "${NAMESPACE}"
                        kubectl rollout restart deployment/worker -n "${NAMESPACE}"
                    '''
                }
            }
        }

        stage('Rollout') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        kubectl rollout status deployment/backend -n "${NAMESPACE}" --timeout=180s
                        kubectl rollout status deployment/worker -n "${NAMESPACE}" --timeout=180s
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        kubectl get deployments,pods,services,ingress -n "${NAMESPACE}" -o wide

                        BACKEND_DIGEST=$(cat backend-digest.txt)
                        WORKER_DIGEST=$(cat worker-digest.txt)

                        RUNNING_BACKEND=$(kubectl get deployment backend -n "${NAMESPACE}" -o jsonpath='{.spec.template.spec.containers[0].image}')
                        RUNNING_WORKER=$(kubectl get deployment worker -n "${NAMESPACE}" -o jsonpath='{.spec.template.spec.containers[0].image}')

                        echo "backend running image: ${RUNNING_BACKEND}"
                        echo "worker running image:  ${RUNNING_WORKER}"

                        if ! echo "${RUNNING_BACKEND}" | grep -q "${BACKEND_DIGEST}"; then
                            echo "ERROR: running backend image does not match expected digest ${BACKEND_DIGEST}" >&2
                            exit 1
                        fi
                        if ! echo "${RUNNING_WORKER}" | grep -q "${WORKER_DIGEST}"; then
                            echo "ERROR: running worker image does not match expected digest ${WORKER_DIGEST}" >&2
                            exit 1
                        fi
                        echo "Verified: running images match the requested digests."
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        BACKEND_POD=$(kubectl get pods -n "${NAMESPACE}" -l app=backend -o jsonpath='{.items[0].metadata.name}')
                        WORKER_POD=$(kubectl get pods -n "${NAMESPACE}" -l app=worker -o jsonpath='{.items[0].metadata.name}')

                        echo "Smoke-testing backend pod ${BACKEND_POD} at /api/health ..."
                        kubectl exec -n "${NAMESPACE}" "${BACKEND_POD}" -- python3 -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/api/health', timeout=5).status)"

                        echo "Smoke-testing worker pod ${WORKER_POD} at /health ..."
                        kubectl exec -n "${NAMESPACE}" "${WORKER_POD}" -- python3 -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5001/health', timeout=5).status)"
                    '''
                }
            }
        }
    }

    post {
        always {
            container('kubectl') {
                sh 'rm -f backend-digest.txt worker-digest.txt manifest-files.txt || true'
            }
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
        success {
            echo "CD succeeded: backend@${env.BACKEND_DIGEST} and worker@${env.WORKER_DIGEST} deployed to ${params.NAMESPACE}, triggered by ${params.TRIGGERED_BY_BUILD}."
        }
        failure {
            container('kubectl') {
                sh '''
                    kubectl get events -n "${NAMESPACE}" --sort-by=.lastTimestamp | tail -50 || true
                '''
            }
            echo """
CD FAILED. Manual rollback:
  kubectl rollout undo deployment/backend -n devops-app
  kubectl rollout undo deployment/worker -n devops-app
"""
        }
    }
}