// pipelines/Jenkinsfile-cd
//
// CD pipeline for the devops-app backend + worker services.
//
// Responsibility boundary: this pipeline NEVER builds or pushes images. It
// only takes an already-built, already-scanned, already-pushed image
// tag+digest (produced by application-ci) and deploys it. All application
// manifests come from AWS-DevOps-Kubernetes (checked out into app-src/ below,
// read-only — this pipeline never modifies that repo).
//
// Deploy strategy: kubectl apply reconciles the full manifest set (minus
// namespace/secret files, which are managed out-of-band), then backend/worker
// images are pinned explicitly by DIGEST (not tag) so the exact tested
// artifact is what actually runs, immune to any tag mutation.

pipeline {
    agent { label 'cd-agent' }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Immutable image tag produced by CI (e.g. <short-sha>-<build-number>).')
        string(name: 'IMAGE_DIGEST', defaultValue: '', description: 'backend=sha256:...,worker=sha256:... — digests produced by CI.')
        string(name: 'NAMESPACE', defaultValue: 'devops-app', description: 'Target namespace. Manifests are currently hardcoded to devops-app.')
        string(name: 'TRIGGERED_BY_BUILD', defaultValue: '', description: 'Upstream CI build identifier/URL, for traceability.')
    }

    environment {
        ECR_REGISTRY    = "938834037970.dkr.ecr.us-east-1.amazonaws.com"
        AWS_REGION      = "us-east-1"
        APP_REPO_URL    = "https://github.com/BarBalilos/AWS-DevOps-Kubernetes.git"
        APP_REPO_BRANCH = "main"
    }

    stages {

        stage('Checkout') {
            steps {
                container('kubectl') {
                    sh 'apk add --no-cache git > /dev/null'
                    dir('app-src') {
                        git branch: "${APP_REPO_BRANCH}", url: "${APP_REPO_URL}"
                    }
                    echo "Checked out app-src @ branch ${APP_REPO_BRANCH} (manifests only — no build happens here)."
                }
            }
        }

        stage('Input Validation') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu

                        if [ -z "${IMAGE_TAG}" ] || [ "${IMAGE_TAG}" = "latest" ]; then
                          echo "REJECTED: IMAGE_TAG must be a specific immutable tag, not empty or 'latest'. Got: '${IMAGE_TAG}'"
                          exit 1
                        fi

                        BACKEND_DIGEST=$(echo "${IMAGE_DIGEST}" | tr ',' '\\n' | grep '^backend=' | cut -d'=' -f2-)
                        WORKER_DIGEST=$(echo "${IMAGE_DIGEST}" | tr ',' '\\n' | grep '^worker=' | cut -d'=' -f2-)

                        case "$BACKEND_DIGEST" in
                          sha256:*) ;;
                          *) echo "REJECTED: backend digest missing/invalid in IMAGE_DIGEST. Got: '${IMAGE_DIGEST}'"; exit 1 ;;
                        esac
                        case "$WORKER_DIGEST" in
                          sha256:*) ;;
                          *) echo "REJECTED: worker digest missing/invalid in IMAGE_DIGEST. Got: '${IMAGE_DIGEST}'"; exit 1 ;;
                        esac

                        if [ "${NAMESPACE}" != "devops-app" ]; then
                          echo "REJECTED: manifests are currently hardcoded to namespace 'devops-app'; NAMESPACE='${NAMESPACE}' is not supported yet (multi-env promotion is a future bonus item)."
                          exit 1
                        fi

                        kubectl get namespace "${NAMESPACE}" > /dev/null

                        echo "$BACKEND_DIGEST" > backend-digest.txt
                        echo "$WORKER_DIGEST"  > worker-digest.txt

                        echo "Input validation OK."
                        echo "  IMAGE_TAG:           ${IMAGE_TAG}"
                        echo "  BACKEND_DIGEST:      $BACKEND_DIGEST"
                        echo "  WORKER_DIGEST:       $WORKER_DIGEST"
                        echo "  NAMESPACE:           ${NAMESPACE}"
                        echo "  TRIGGERED_BY_BUILD:  ${TRIGGERED_BY_BUILD}"
                    '''
                    script {
                        env.BACKEND_DIGEST = sh(script: 'cat backend-digest.txt', returnStdout: true).trim()
                        env.WORKER_DIGEST  = sh(script: 'cat worker-digest.txt', returnStdout: true).trim()
                    }
                }
            }
        }

        stage('Manifest Discovery & Validation') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        find app-src/k8s -maxdepth 1 -type f -name '*.yaml' ! -name '*namespace*' ! -name '*secret*' | sort > manifest-files.txt
                        echo "Manifests to apply (namespace/secret files excluded by design):"
                        cat manifest-files.txt

                        while IFS= read -r f; do
                          echo "-- dry-run client: $f --"
                          kubectl apply --dry-run=client -f "$f"
                        done < manifest-files.txt

                        while IFS= read -r f; do
                          echo "-- dry-run server: $f --"
                          kubectl apply --dry-run=server -f "$f"
                        done < manifest-files.txt
                    '''
                }
            }
        }

        stage('Authenticate / RBAC Sanity Check') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        echo "Cluster (via in-cluster ServiceAccount jenkins-cd-agent):"
                        kubectl cluster-info | head -1

                        kubectl auth can-i patch deployments -n "${NAMESPACE}" \
                          || { echo "Missing deployments patch permission in ${NAMESPACE}"; exit 1; }
                        kubectl auth can-i create pods --subresource=exec -n "${NAMESPACE}" \
                          || { echo "Missing pods/exec create permission in ${NAMESPACE} (needed for smoke test)"; exit 1; }

                        echo "RBAC sanity checks passed."
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu

                        while IFS= read -r f; do
                          echo "-- apply: $f --"
                          kubectl apply -f "$f"
                        done < manifest-files.txt

                        BACKEND_DIGEST=$(cat backend-digest.txt)
                        WORKER_DIGEST=$(cat worker-digest.txt)

                        echo "Pinning backend to digest ${BACKEND_DIGEST}..."
                        kubectl set image deployment/backend \
                          backend="${ECR_REGISTRY}/devops-app-backend@${BACKEND_DIGEST}" \
                          -n "${NAMESPACE}"

                        echo "Pinning worker to digest ${WORKER_DIGEST}..."
                        kubectl set image deployment/worker \
                          worker="${ECR_REGISTRY}/devops-app-worker@${WORKER_DIGEST}" \
                          -n "${NAMESPACE}"

                        kubectl annotate deployment/backend -n "${NAMESPACE}" \
                          deployed-image-tag="${IMAGE_TAG}" \
                          deployed-by-build="${TRIGGERED_BY_BUILD}" \
                          --overwrite
                        kubectl annotate deployment/worker -n "${NAMESPACE}" \
                          deployed-image-tag="${IMAGE_TAG}" \
                          deployed-by-build="${TRIGGERED_BY_BUILD}" \
                          --overwrite
                    '''
                }
            }
        }

        stage('Rollout') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        kubectl rollout status deployment/backend -n "${NAMESPACE}" --timeout=180s
                        kubectl rollout status deployment/worker  -n "${NAMESPACE}" --timeout=180s
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        kubectl get deployments,pods,services,ingress -n "${NAMESPACE}" -o wide

                        BACKEND_DIGEST=$(cat backend-digest.txt)
                        WORKER_DIGEST=$(cat worker-digest.txt)

                        RUNNING_BACKEND=$(kubectl get deployment backend -n "${NAMESPACE}" -o jsonpath='{.spec.template.spec.containers[0].image}')
                        RUNNING_WORKER=$(kubectl get deployment worker -n "${NAMESPACE}" -o jsonpath='{.spec.template.spec.containers[0].image}')

                        echo "backend running image: $RUNNING_BACKEND"
                        echo "worker running image:  $RUNNING_WORKER"

                        echo "$RUNNING_BACKEND" | grep -q "${BACKEND_DIGEST}" || { echo "MISMATCH: backend is not running the expected digest"; exit 1; }
                        echo "$RUNNING_WORKER"  | grep -q "${WORKER_DIGEST}"  || { echo "MISMATCH: worker is not running the expected digest"; exit 1; }

                        echo "Verified: running images match the requested digests."
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                container('kubectl') {
                    sh '''
                        set -eu
                        BACKEND_POD=$(kubectl get pods -n "${NAMESPACE}" -l app=backend -o jsonpath='{.items[0].metadata.name}')
                        WORKER_POD=$(kubectl get pods -n "${NAMESPACE}" -l app=worker -o jsonpath='{.items[0].metadata.name}')

                        echo "Smoke-testing backend pod ${BACKEND_POD} at /api/health ..."
                        kubectl exec -n "${NAMESPACE}" "${BACKEND_POD}" -- \
                          python3 -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5000/api/health', timeout=5).status)"

                        echo "Smoke-testing worker pod ${WORKER_POD} at /health ..."
                        kubectl exec -n "${NAMESPACE}" "${WORKER_POD}" -- \
                          python3 -c "import urllib.request; print(urllib.request.urlopen('http://localhost:5001/health', timeout=5).status)"
                    '''
                }
            }
        }
    }

    post {
        always {
            container('kubectl') {
                sh 'rm -f backend-digest.txt worker-digest.txt manifest-files.txt || true'
            }
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
        success {
            echo "CD succeeded: backend@${env.BACKEND_DIGEST} and worker@${env.WORKER_DIGEST} deployed to ${params.NAMESPACE}, triggered by ${params.TRIGGERED_BY_BUILD}."
        }
        failure {
            container('kubectl') {
                sh '''
                    echo "== Recent events in ${NAMESPACE} (diagnostics) =="
                    kubectl get events -n "${NAMESPACE}" --sort-by=.lastTimestamp | tail -50 || true
                '''
            }
            echo '''
CD FAILED. This pipeline does not auto-rollback. To manually roll back:
  kubectl rollout undo deployment/backend -n devops-app
  kubectl rollout undo deployment/worker  -n devops-app
Then re-run application-cd with a known-good IMAGE_TAG/IMAGE_DIGEST once the root cause is fixed.
'''
        }
    }
}